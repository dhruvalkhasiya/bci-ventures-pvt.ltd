# Backend Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bci-ventures
JWT_SECRET=your_jwt_secret_key_change_in_production
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin User Defaults
ADMIN_NAME=BCI Administrator
ADMIN_EMAIL=admin@bciventures.in
ADMIN_PASSWORD=Admin@12345

# Email & Notifications
NOTIFICATION_EMAIL=registrationbci@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=registrationbci@gmail.com
SMTP_PASS=your_smtp_app_password